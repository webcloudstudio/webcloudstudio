---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Web Cloud Studio">
  <section class="home-hero">
    <div class="home-inner">
      <div class="home-body">
<div class="drydock-feature">
  <div class="drydock-copy">
    <p class="feature-kicker">Featured Presentation</p>
    <h2>Drydock: Specification Driven Software Delivery</h2>
    <ul>
      <li>Based an Agile </li>
      <li>Based on Test Driven Development.</li>
      <li>Dependency Graph of Stories.</li>
      <li>Web Interface</li>
      <li>Context Compression, Context Optimization.</li>
      <li>Drydock turns specifications into working software.</li>
      <li>Drydock turns messy specifications into tested working software.</li>
      <li>A repeatable method to build from the specification and evolve with it.</li>
    </ul>
    <div class="feature-actions">
      <a class="feature-action--primary" href="/project-docs/drydock/QUICK_START.html" target="_blank" rel="noopener">Quick Start</a>
      <a href="https://webcloudstudio.github.io/Drydock/" target="_blank" rel="noopener">Documentation</a>
      <a href="https://webcloudstudio.github.io/Drydock/USER_INSTALLATION.pdf" target="_blank" rel="noopener">Installation</a>
    </div>
    <div class="feature-actions feature-actions--three">
      <a href="https://github.com/webcloudstudio/Drydock" target="_blank" rel="noopener">GitHub</a>
      <a href="/project-docs/drydock/drydock_process_long.svg" target="_blank" rel="noopener">CLI</a>
      <a href="/project-docs/drydock/presentation2/PRODUCTION_RedditVideo2.web.mp4" target="_blank" rel="noopener">15M Video</a>
    </div>
    <div class="feature-actions feature-actions--three">
      <a href="/project-docs/drydock/papers/Product_Comparison_Matrix.html" target="_blank" rel="noopener">Comparison</a>
    </div>
  </div>

  <div class="drydock-media">
    <div class="drydock-window">
      <div class="window-bar">
        <span></span><span></span><span></span>
      </div>
      <img class="drydock-process" src="/project-docs/drydock/drydock_process.svg" alt="Drydock specification-driven delivery process" />
    </div>
    <div class="evidence-footer">
      <h2>Drydock Build Evidence</h2>
      <div class="evidence-links">
        <a href="https://webcloudstudio.github.io/drydock-example-readinglist/" target="_blank" rel="noopener">Reading List</a>
        <a href="https://webcloudstudio.github.io/drydock-example-commonmark/" target="_blank" rel="noopener">CommonMark</a>
        <a href="https://webcloudstudio.github.io/drydock-example-toml/" target="_blank" rel="noopener">TOML</a>
        <a href="https://webcloudstudio.github.io/drydock-example-jq/" target="_blank" rel="noopener">jq</a>
      </div>
    </div>
  </div>
</div>
      </div>
    </div>
  </section>

  <style>
    .home-hero { padding: 3rem 0 4rem; }

    .home-inner {
      max-width: 1280px;
      margin: 0 auto;
      padding: 0 1.5rem;
    }

    .home-body > div {
      margin: 0 0 2.25rem;
      min-width: 0;
    }

    .drydock-feature {
      display: grid;
      grid-template-columns: minmax(0, 0.92fr) minmax(420px, 1.08fr);
      gap: 1.75rem;
      align-items: stretch;
      padding: 1.75rem 1.9rem;
      background: #0e0e1a;
      border: 1px solid #2cb67d66;
      border-radius: 12px;
      box-shadow: 0 18px 60px #2cb67d14;
    }

    .feature-kicker {
      margin: 0 0 0.6rem;
      color: #2cb67d;
      font-size: 0.78rem;
      font-weight: 800;
      letter-spacing: 0.16em;
      text-transform: uppercase;
    }

    .home-body .drydock-copy h2,
    .home-body .marina-note h2 {
      margin: 0 0 0.9rem;
      font-size: clamp(1.5rem, 2.6vw, 1.9rem);
      font-weight: 800;
      line-height: 1.08;
      letter-spacing: -0.02em;
      color: #f1f5f9;
    }

    .drydock-copy p {
      color: #cbd5e1;
      font-size: 1rem;
      line-height: 1.65;
      margin: 0 0 1.1rem;
    }

    .drydock-copy ul {
      list-style: none;
      padding: 0;
      margin: 1.15rem 0;
      display: flex;
      flex-direction: column;
      gap: 0.55rem;
      color: #cbd5e1;
      font-size: 0.95rem;
      line-height: 1.55;
    }

    .feature-actions {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 0.65rem;
      align-items: center;
      margin-top: 1.25rem;
    }

    /* Second action row — three equal-width buttons. */
    .feature-actions--three {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      margin-top: 0.65rem;
    }

    .feature-actions a {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      text-decoration: none;
      border: 1px solid #4f9cf9;
      color: #4f9cf9;
      padding: 0.58rem 0.9rem;
      border-radius: 6px;
      font-size: 0.86rem;
      font-weight: 700;
      min-height: 40px;
      text-align: center;
      white-space: nowrap;
    }

    .feature-actions a:hover {
      background: #4f9cf9;
      color: #080810;
      text-decoration: none;
    }

    /* Standout primary action — the Quick Start link. */
    .feature-actions a.feature-action--primary {
      background: #4f9cf9;
      color: #080810;
      box-shadow: 0 0 0 3px #4f9cf933;
    }

    .feature-actions a.feature-action--primary:hover {
      background: #7fb8ff;
      border-color: #7fb8ff;
      color: #080810;
    }

    /* Right column of the feature — process image on top, build evidence below,
       pinned to the bottom so it lines up with the blue action rows on the left. */
    .drydock-media {
      display: flex;
      flex-direction: column;
      min-width: 0;
    }

    /* Build-evidence block — centered header plus green link row. */
    .evidence-footer {
      margin: auto 0 0;
      padding-top: 1.25rem;
    }

    .evidence-footer hr,
    .home-body .evidence-footer hr {
      border: 0;
      border-top: 1px solid #252540;
      margin: 0 0 1.5rem;
    }

    .evidence-footer h2,
    .home-body .evidence-footer h2 {
      margin: 0 0 1rem;
      text-align: center;
      font-size: 1.05rem;
      font-weight: 700;
      letter-spacing: 0.01em;
    }

    .evidence-links {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 0.65rem;
    }

    .evidence-links a,
    .home-body .evidence-links a {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      text-decoration: none;
      border: 1px solid #4ade80;
      color: #4ade80;
      padding: 0.58rem 1.1rem;
      border-radius: 6px;
      font-size: 0.86rem;
      font-weight: 700;
      min-height: 40px;
      text-align: center;
      white-space: nowrap;
    }

    .evidence-links a:hover,
    .home-body .evidence-links a:hover {
      background: #4ade80;
      color: #080810;
      text-decoration: none;
    }

    .drydock-window {
      min-width: 0;
      background: #05070c;
      border: 1px solid #252540;
      border-radius: 10px;
      overflow: hidden;
      box-shadow: 0 14px 42px #0000004d;
    }

    .window-bar {
      height: 32px;
      display: flex;
      align-items: center;
      gap: 0.45rem;
      padding: 0 0.85rem;
      background: #151522;
      border-bottom: 1px solid #252540;
    }

    .window-bar span {
      width: 10px;
      height: 10px;
      border-radius: 50%;
      background: #64748b;
      display: block;
    }

    .window-bar span:nth-child(1) { background: #f87171; }
    .window-bar span:nth-child(2) { background: #fb923c; }
    .window-bar span:nth-child(3) { background: #4ade80; }

    .drydock-process {
      width: 100%;
      height: auto;
      display: block;
    }

    .marina-note {
      margin: 2.25rem 0;
      padding: 1.5rem 1.75rem;
      background: #0e0e1a;
      border: 1px solid #252540;
      border-radius: 12px;
    }

    .marina-note p {
      margin: 0 0 1.1rem;
      color: #cbd5e1;
      font-size: 0.95rem;
      line-height: 1.6;
    }

    .marina-note a {
      color: #4f9cf9;
      font-weight: 600;
      text-decoration: none;
    }

    .marina-note ul {
      list-style: none;
      margin: 0;
      padding: 0;
      display: flex;
      flex-direction: column;
      gap: 0.7rem;
    }

    .marina-note li {
      padding-left: 0;
      color: #f1f5f9;
      font-weight: 600;
    }

    .marina-note li::before {
      content: none;
    }

    .marina-note li span {
      display: block;
      color: #94a3b8;
      font-size: 0.88rem;
      font-weight: 400;
      line-height: 1.5;
    }

    .drydock-video {
      width: 100%;
      height: 100%;
      display: block;
      object-fit: contain;
      background: #05070c;
    }

    @media (max-width: 960px) {
      .drydock-feature {
        grid-template-columns: minmax(0, 1fr);
      }

    }

    @media (max-width: 560px) {
      .feature-actions {
        grid-template-columns: minmax(0, 1fr);
      }

      .feature-actions a { grid-column: span 1; }
    }

    .home-body p {
      font-size: 1.05rem;
      color: var(--muted);
      line-height: 1.75;
      margin: 0 0 1.25rem;
    }

    .home-body h2 {
      font-size: 1.1rem;
      font-weight: 700;
      color: var(--text);
      margin: 2rem 0 0.75rem;
      letter-spacing: 0.01em;
    }

    .home-body h3 {
      font-size: 1rem;
      font-weight: 700;
      color: var(--text);
      margin: 1.75rem 0 0.6rem;
    }

    .home-body ul {
      list-style: none;
      padding: 0;
      margin: 0 0 1.25rem;
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
    }

    .home-body li {
      font-size: 0.95rem;
      color: var(--muted);
      padding-left: 1.2rem;
      position: relative;
    }

    .home-body li::before {
      content: '—';
      position: absolute;
      left: 0;
      color: var(--accent);
    }

    .home-body strong { color: var(--text); font-weight: 600; }

    .home-body a { color: var(--accent); }
    .home-body a:hover { text-decoration: underline; }

    .home-body em {
      color: var(--muted);
      font-style: italic;
      font-size: 0.92rem;
    }

  </style>
</Layout>
